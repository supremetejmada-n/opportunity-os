# ==========================================
# Opportunity OS — Environment Configuration
# ==========================================

# --- Server & Network ---
PORT=3001
NODE_ENV=production
# In production, set to your Vercel frontend URL (e.g. https://opportunity-os.vercel.app)
# Supports comma-separated origins: https://app.example.com,http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- SQLite Persistent Storage ---
# For Docker / Railway / Render persistent volumes (e.g., /data/opportunity_engine.db)
DB_PATH=./data/opportunity_engine.db

# --- Authentication & Multi-Tenancy Security ---
# Strong HMAC-SHA256 secret for internal JWT signing (min 32 random characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_min_32_char_cryptographically_secure_random_string

# Optional: Supabase Auth integration. If using Supabase for auth, provide your project's JWT Secret here.
# Found in Supabase Dashboard -> Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=

# Initial owner account credentials
INITIAL_OWNER_EMAIL=owner@opportunityos.local
INITIAL_OWNER_PASSWORD=replace_with_strong_password_min_16_chars

# --- Transactional Email Provider (Password Reset) ---
# Configure at least one provider to enable live password reset emails:
# Resend (Recommended): https://resend.com
RESEND_API_KEY=
# SendGrid: https://sendgrid.com
SENDGRID_API_KEY=
# Postmark: https://postmarkapp.com
POSTMARK_SERVER_TOKEN=
# Sender identity:
EMAIL_FROM=Opportunity OS <noreply@yourdomain.com>
# Public Frontend URL (used to generate password reset links in emails)
APP_URL=http://localhost:3000

# --- Razorpay Payment Gateway (₹8/Month Subscription) ---
# For local test mode, use test keys from Razorpay Dashboard (e.g. rzp_test_...)
# For production, use live keys (e.g. rzp_live_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Frontend Environment Variables (Vercel / Client) ---
# Set this in your Vercel Project Settings -> Environment Variables
# Points to your persistent backend API URL (e.g. https://api.opportunityos.com)
# Leave empty or omit during local development to use default relative /api proxy
# VITE_API_URL=https://api.opportunityos.com
# Public Razorpay Key ID for client-side checkout popup (safe for frontend)
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# --- AI Provider & Discovery Pipeline ---
# Local Ollama Configuration (Default for ₹0 Local Inference)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Google Gemini API Configuration (Optional Cloud Fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Router Settings
AI_DEFAULT_PROVIDER=auto
AI_TIMEOUT_MS=15000
